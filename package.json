{
  "name": "biocollect",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --dir apps/api dev",
    "build": "pnpm --dir apps/api build",
    "mobile:build": "pnpm --dir apps/mobile exec expo export --platform web --output-dir dist-web",
    "quality": "pnpm check && pnpm test && pnpm build && pnpm mobile:build",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "generate:locales": "pnpm --dir packages/i18n generate",
    "check": "pnpm generate:locales && pnpm --dir apps/api check && pnpm --dir apps/mobile check",
    "test": "pnpm generate:locales && pnpm --dir apps/api test && pnpm --dir apps/mobile test",
    "mobile:check": "pnpm --dir apps/mobile check",
    "mobile:test": "pnpm --dir apps/mobile test",
    "mobile:start": "pnpm --dir apps/mobile start"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "vite@<=6.4.1": ">=6.4.2",
      "drizzle-orm@<0.45.2": ">=0.45.2",
      "postcss@<8.5.10": ">=8.5.10",
      "uuid@<11.1.1": ">=11.1.1",
      "vite@<=6.4.2": ">=6.4.3",
      "postcss@<=8.5.11": ">=8.5.12",
      "postcss@<=8.5.22": ">=8.5.23",
      "postcss@<=8.5.17": ">=8.5.18",
      "vitest@<3.2.6": ">=3.2.6"
    }
  }
}
